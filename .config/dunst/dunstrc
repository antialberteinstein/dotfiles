[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 100)
    offset = (20, 20)
    transparency = 0
    frame_color = "#89b4fa"
    separator_color = frame
    font = JetBrainsMono Nerd Font 10
    padding = 8
    line_height = 4
    corner_radius = 10

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    timeout = 3

[urgency_critical]
    background = "#f38ba8"
    foreground = "#1e1e2e"
    timeout = 10

